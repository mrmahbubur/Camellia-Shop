# APP_URL: The public base URL where Camellia Shop is hosted.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Server-only runtime key automatically injected for optional backend storefront control.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SITE_CONTROL_SECRET: Optional bearer token required for remote /api/internal/control calls.
SITE_CONTROL_SECRET=""

# GEOIP_PROVIDER_URL: Optional server-side IP geolocation lookup URL template (use {ip} placeholder; never logged or stored).
GEOIP_PROVIDER_URL=""

# GEOIP_API_KEY: Optional API key header/token for the configured server-side GeoIP provider.
GEOIP_API_KEY=""

# VITE_API_BASE_URL: Optional public base URL of a separately hosted Node/Express API for static GitHub Pages builds (never put secrets here).
VITE_API_BASE_URL=""

# Server-side AliExpress affiliate configuration overrides (optional; defaults to curated s.click.aliexpress.com links)
ALIEXPRESS_ENABLED="true"
ALIEXPRESS_PORTAL_URL=""
ALIEXPRESS_AFFILIATE_URL=""
ALIEXPRESS_EVENT_URL=""
ALIEXPRESS_SQUARE_EVENT_URL=""
ALIEXPRESS_JEWELRY_URL=""
ALIEXPRESS_BEAUTY_URL=""
ALIEXPRESS_TOYS_URL=""
ALIEXPRESS_WOMENS_CLOTHING_URL=""

