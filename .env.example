# APP_URL: The public base URL where Camellia Shop is hosted.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Server-only runtime key automatically injected for backend storefront control.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SITE_CONTROL_SECRET: Optional bearer token required for remote /api/internal/control calls.
SITE_CONTROL_SECRET=""
